# Copia este fichero a .env y rellena los valores. Nunca subas .env a git.

# Imagen y usuario del proceso (UID/GID con permiso de escritura en los
# directorios de media, ver deploy/README.md)
IMAGE=ghcr.io/aacienfuegos/media-management:latest
APP_UID=
APP_GID=

# Rutas del host del LXC
MEDIA_DIR=
DATA_DIR=
ROOTS_FILE=
MANIFEST_DIR=
MANIFEST_FILE=buceo.candidate.json
IDS_EXPORT_DIR=

# Puertos publicados (limitar a la IP de Traefik con el cortafuegos del LXC)
PANEL_BIND=8002
API_BIND=8003
PUBLIC_BIND=8080

# nginx delante del público
TRAEFIK_IP=
DOWNLOAD_RATE=8m
DOWNLOAD_CONN_PER_IP=4
API_RATE=30r/m
SHARE_SUBNET=172.31.250.0/24
SHARE_NGINX_IP=172.31.250.10

# Secretos
MM_SECRET_KEY=
MM_NTFY_TOKEN=

# Servicios y confianza
MM_JELLYFIN_URL=
MM_TRUSTED_PROXIES=[]
MM_PANEL_ALLOWED_USERS=[]
MM_PUBLIC_URL=
MM_PANEL_URL=
MM_NTFY_URL=
MM_NTFY_TOPIC=
