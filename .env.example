# Copia este fichero a .env y rellena los valores. Nunca subas .env a git.

# Imágenes, siempre por digest: un tag cambia sin que nadie lo decida. Se actualizan a
# mano (deploy/README.md, "Actualizar").
IMAGE=ghcr.io/aacienfuegos/media-management@sha256:<digest>
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.28-alpine@sha256:7377697a821c131a924a7105fafbe7414db4e9fcc77a6f08f776f33f141ec3f8

# Usuario del proceso (UID/GID con permiso de escritura en los directorios de media,
# ver deploy/README.md)
APP_UID=
APP_GID=

# Rutas del host del LXC
MEDIA_DIR=
DATA_DIR=
ROOTS_FILE=
# Durante el traspaso del manifiesto, MANIFEST_DIR es un directorio propio del
# candidato y MANIFEST_CURRENT_DIR el que lee producción (compose.compare.yaml, solo
# lectura). Tras el traspaso, MANIFEST_DIR pasa a ser el de producción.
MANIFEST_DIR=
MANIFEST_FILE=buceo.candidate.json
MANIFEST_CURRENT_DIR=
# Durante el traspaso: COMPOSE_FILE=compose.yaml:compose.compare.yaml
IDS_EXPORT_DIR=
# ZIP de cada enlace (lo escribe solo el worker, nginx lo lee). Fuera de MEDIA_DIR y
# con el marcador .zips-root creado en el disco real antes de montarlo: sin él no se
# genera ni se borra nada (deploy/README.md, "ZIP de los enlaces").
ZIPS_DIR=
# Espacio que tiene que quedar libre en ZIPS_DIR después de generar un zip, y tamaño
# máximo de un zip (0 = sin tope). En GB.
ZIP_MIN_FREE_GB=20
ZIP_MAX_GB=0

# Puertos publicados (limitar a la IP de Traefik con el cortafuegos del LXC)
PANEL_BIND=8002
API_BIND=8003
PUBLIC_BIND=8080

# nginx delante del público
TRAEFIK_IP=
# Por conexión (12m ≈ 100 Mbit/s): 4 GB en unos 5 minutos. El tope global no lo pone
# nginx sino el límite de la interfaz del LXC (deploy/README.md, "Ancho de banda").
DOWNLOAD_RATE=12m
DOWNLOAD_CONN_PER_IP=4
API_RATE=30r/m
SHARE_SUBNET=172.31.250.0/24
SHARE_NGINX_IP=172.31.250.10

# Secretos. Cada uno llega solo a su contenedor (compose.yaml). Claves de al menos
# 32 caracteres aleatorios, distintas entre sí: openssl rand -base64 48
MM_TICKET_KEY=
MM_CSRF_KEY=
MM_NTFY_TOKEN=

# Servicios y confianza
MM_JELLYFIN_URL=
MM_TRUSTED_PROXIES=[]
MM_PANEL_ALLOWED_USERS=[]
MM_PUBLIC_URL=
# Nombre que ve quien abre un enlace: "<nombre> te ha compartido estos archivos".
MM_SHARE_SENDER=
MM_PANEL_URL=
MM_NTFY_URL=
MM_NTFY_TOPIC=
