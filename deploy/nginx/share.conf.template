# Plantilla para la imagen oficial de nginx (/etc/nginx/templates/): se rellenan
# solo las variables de entorno definidas, las $variables de nginx quedan tal cual.
#
#   TRAEFIK_IP             IP desde la que llega Traefik (la única de la que se cree X-Forwarded-For)
#   PUBLIC_UPSTREAM        proceso público, p. ej. public:8001
#   MEDIA_DIR              raíz de media dentro del contenedor de nginx (solo lectura)
#   DOWNLOAD_RATE          límite de velocidad por conexión de descarga, p. ej. 8m
#   DOWNLOAD_CONN_PER_IP   descargas simultáneas por IP
#   API_RATE               peticiones por minuto a /api/ por IP, p. ej. 30r/m

log_format mm_json escape=json '{"ts":"$time_iso8601","ip":"$remote_addr","method":"$request_method",'
                               '"uri":"$uri","status":$status,"bytes":$body_bytes_sent,'
                               '"range":"$http_range","ua":"$http_user_agent","rt":$request_time}';

limit_conn_zone $binary_remote_addr zone=mm_conn:10m;
limit_req_zone $binary_remote_addr zone=mm_api:10m rate=${API_RATE};
limit_req_zone $binary_remote_addr zone=mm_page:10m rate=120r/m;

server {
    listen 8080;
    server_tokens off;

    # La IP real solo se toma de Traefik. Su entrypoint público no tiene trustedIPs,
    # así que descarta el X-Forwarded-For de internet y pone el suyo: el último valor
    # es el cliente. De cualquier otro origen, X-Forwarded-For no significa nada.
    set_real_ip_from ${TRAEFIK_IP};
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;

    access_log /dev/stdout mm_json;
    client_max_body_size 16k;
    limit_conn_status 429;
    limit_req_status 429;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header Cookie "";
    proxy_http_version 1.1;

    location /api/ {
        limit_req zone=mm_api burst=20 nodelay;
        proxy_pass http://${PUBLIC_UPSTREAM};
    }

    location /download/ {
        limit_req zone=mm_page burst=60 nodelay;
        limit_conn mm_conn ${DOWNLOAD_CONN_PER_IP};
        proxy_pass http://${PUBLIC_UPSTREAM};
    }

    # Solo alcanzable por X-Accel-Redirect desde la app, que ya ha validado el ticket
    # y la ruta. Los bytes, los 206/Range y las reanudaciones son cosa de nginx.
    location /_protected/ {
        internal;
        alias ${MEDIA_DIR}/;
        limit_conn mm_conn ${DOWNLOAD_CONN_PER_IP};
        limit_rate ${DOWNLOAD_RATE};
        types { }
        default_type application/octet-stream;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control "private, no-store" always;
    }

    location / {
        limit_except GET HEAD { deny all; }
        limit_req zone=mm_page burst=60 nodelay;
        proxy_pass http://${PUBLIC_UPSTREAM};
    }
}
