# /etc/default/media-management-ids (valores reales solo en el host)
MM_EXPORT_CTID=
MM_EXPORT_DB=/var/lib/jellyfin/data/jellyfin.db
# Rutas de las bibliotecas tal y como las ve Jellyfin dentro de su contenedor,
# separadas por comas
MM_EXPORT_LIBRARY_DIRS=
# Fichero de salida, en un directorio montado en solo lectura en el LXC de la app
MM_EXPORT_OUT=
