[Unit]
Description=Vacía la papelera de media-management (más de 30 días)
# Las rutas van en el drop-in (media-trash-purge.service.d/paths.conf.example): systemd
# no expande variables en RequiresMountsFor ni en ReadWritePaths. Sin él, falla.
AssertPathExists=/etc/systemd/system/media-trash-purge.service.d/paths.conf

[Service]
Type=oneshot
EnvironmentFile=/etc/default/media-trash-purge
ExecStart=/usr/local/lib/media-management/media-trash-purge.sh
Nice=10
# Solo puede escribir en la papelera (ReadWritePaths, en el drop-in): aunque algo lo
# desviara, el resto del sistema y de la biblioteca es de solo lectura para este servicio.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER
