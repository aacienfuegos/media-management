[Unit]
Description=Vacía la papelera de media-management (más de 30 días)
RequiresMountsFor=/ruta/a/media

[Service]
Type=oneshot
EnvironmentFile=/etc/default/media-trash-purge
ExecStart=/usr/local/lib/media-management/media-trash-purge.sh
Nice=10
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
