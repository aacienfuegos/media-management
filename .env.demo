# Modo demo (ver compose.demo.yaml). Sin secretos: las claves las genera ./demo.sh en
# .env.demo.keys, ignorado por git. Nunca copies estas rutas ni esas claves a un
# despliegue real.

IMAGE=media-management:demo
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.28-alpine@sha256:7377697a821c131a924a7105fafbe7414db4e9fcc77a6f08f776f33f141ec3f8

# ./demo.sh los sustituye por los de quien lo ejecuta.
APP_UID=1000
APP_GID=1000

# Cada directorio, vacío o con .demo-root: la siembra se niega con cualquier otro.
MEDIA_DIR=./demo-data/media
DATA_DIR=./demo-data/data
ZIPS_DIR=./demo-data/zips
MANIFEST_DIR=./demo-data/manifest
MANIFEST_FILE=buceo.json
IDS_EXPORT_DIR=./demo-data/jellyfin-ids
DEMO_JELLYFIN_DIR=./demo-data/jellyfin
ROOTS_FILE=./deploy/demo/roots.toml
ZIP_MIN_FREE_GB=1

API_BIND=127.0.0.1:8003
PUBLIC_BIND=127.0.0.1:8080
# Nadie: en local no hay Traefik delante de nginx.
TRAEFIK_IP=127.0.0.1
# Distinta de la de compose.yaml, para que el demo conviva con un despliegue en la misma máquina.
SHARE_SUBNET=172.31.252.0/24
SHARE_NGINX_IP=172.31.252.10

MM_PUBLIC_URL=http://localhost:8080
MM_PANEL_URL=http://localhost:8002
MM_SHARE_SENDER=Demo
